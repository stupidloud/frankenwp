# /root/src/frankenwp/Caddyfile.multisite
# Caddyfile template for multiple WordPress sites (WordPress core mounted via volume under /var/www/sites/)

# Global options block
{
    # IMPORTANT: Replace 'your-email@example.com' with your actual email for Let's Encrypt.
    email your-email@example.com

    # Uncomment the line below to use Let's Encrypt staging environment for testing.
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

    # OCSP Stapling is generally recommended for performance (default on in Caddy 2.7+).
    # ocsp_stapling off # Uncomment if needed for specific environments.

    # FrankenPHP configuration (add worker config if needed)
    frankenphp {
        # worker /path/to/worker.php
        # {$FRANKENPHP_CONFIG} # Placeholder if you want to inject config via env var
    }

    # Directive sorting: process PHP before serving static files.
    order php_server before file_server

    # {$CADDY_GLOBAL_OPTIONS} # Placeholder if you want to inject other global options
}

# <<< SITE_CONFIGURATIONS_BELOW >>>
# --- Site configurations will be added here by the manage_sites.sh script ---
# --- End of Site Configurations ---